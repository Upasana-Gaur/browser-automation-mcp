# ============================================================
# BrowserAutomation MCP Server
# Git Ignore Configuration
# ============================================================


# ============================================================
# PYTHON
# ============================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Python compiled extensions
*.so

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover


